# Server-only. Copy this file to .env.local and use a newly issued key.
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=冰糖

# Browser-entered API keys are accepted automatically only in local development.
# Preview/production requires this explicit opt-in; enable only for private, trusted deployments.
# ALLOW_CLIENT_MIMO_KEY=false

# Optional public URL of a production TTS proxy that implements POST /api/tts.
# Leave unset during local development to use Vite's same-origin middleware.
# VITE_TTS_ENDPOINT=https://example.com/api/tts
